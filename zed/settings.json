{
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff", "ty"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_actions": {
            "source.organizeImports.ruff": true,
            "source.fixAll.ruff": true
          }
        },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    }
  },

  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "typeCheckingMode": "standard",
          "diagnosticMode": "workspace",
          "autoImportCompletions": true
        }
      },
      "initialization_options": {
        "disablePullDiagnostics": true
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "configuration": "~/.config/ruff/ruff.toml"
        }
      }
    }
  },

  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true,
    "show_type_hints": true,
    "show_parameter_hints": false,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": false,
      "alt": false,
      "shift": false,
      "platform": false,
      "function": false
    }
  },

  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "lsp_pull_diagnostics": {
      "enabled": true,
      "debounce_ms": 50
    },
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null
    }
  },

  "file_types": {
    "python": ["*.py"],
    "pip-requirements": ["**/requirements{/**,*}.{txt,in}"],
    "html": ["**/*.html"]
  },

  "show_edit_predictions": false,

  "terminal": {
    "blinking": "on",
    "cursor_shape": "bar",
    "font_size": 18.0,
    "toolbar": {
      "breadcrumbs": true
    }
  },

  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },

  "minimap": {
    "show": "never"
  },

  "current_line_highlight": "all",

  "cursor_shape": "bar",

  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 0,
      "padding": 7,
      "min_column": 0,
      "show_commit_summary": false
    }
  },

  "title_bar": {
    "show": "hide_in_full_screen"
  },

  "tab_bar": {
    "show": false
  },

  "project_panel": {
    "auto_fold_dirs": false,
    "auto_reveal_entries": false,
    "dock": "right",
    "hide_root": true,
    "entry_spacing": "standard",
    "show_diagnostics": "all"
  },

  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },

  "base_keymap": "VSCode",
  "vim_mode": true,

  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 18,

  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 18.0,
  "buffer_line_height": {
    "custom": 1.5
  },

  "theme": {
    "mode": "system",
    "light": "Jellybeans",
    "dark": "Jellybeans"
  },

  "active_pane_modifiers": {
    "inactive_opacity": 0.8
  },

  "bottom_dock_layout": "full",

  "gutter": {
    "line_numbers": true,
    "runnables": false,
    "breakpoints": false,
    "folds": true,
    "min_line_number_digits": 0
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}

{
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    }
  },

  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "typeCheckingMode": "standard",
          "diagnosticMode": "workspace",
          "autoImportCompletions": true
        }
      },
      "initialization_options": {
        "disablePullDiagnostics": true
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "configuration": "~/.config/ruff/ruff.toml"
        }
      }
    }
  },

  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": false,
      "alt": false,
      "shift": false,
      "platform": false,
      "function": false
    }
  },

  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "lsp_pull_diagnostics": {
      "enabled": true,
      "debounce_ms": 50
    },
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null
    }
  },

  "file_types": {
    "python": ["*.py"],
    "pip-requirements": ["**/requirements{/**,*}.{txt,in}"],
    "html": ["**/*.html"]
  },

  "show_edit_predictions": false,

  "terminal": {
    "button": false,
    "blinking": "on",
    "cursor_shape": "bar",
    "font_size": 18,
    "toolbar": {
      "breadcrumbs": false
    }
  },

  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },

  "minimap": {
    "show": "never"
  },

  "current_line_highlight": "all",

  "cursor_shape": "bar",

  "git": {
    "inline_blame": {
      "delay_ms": 0,
      "padding": 7,
      "min_column": 0,
      "show_commit_summary": false
    }
  },

  "title_bar": {
    "show_menus": false,
    "show_sign_in": true,
    "show_user_picture": true,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_icon": false
  },

  "status_bar": {
    "cursor_position_button": false,
    "active_language_button": false
  },

  "tab_bar": {
    "show": false
  },

  "debugger": {
    "button": false
  },
  "search": {
    "center_on_match": true,
    "button": false
  },

  "use_system_window_tabs": true,

  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "notification_panel": {
    "button": false
  },
  "git_panel": {
    "button": false,
    "sort_by_path": false,
    "status_style": "icon",
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right",
    "button": false
  },

  "project_panel": {
    "starts_open": true,
    "git_status": true,
    "folder_icons": false,
    "file_icons": true,
    "hide_gitignore": false,
    "button": false,
    "auto_fold_dirs": false,
    "auto_reveal_entries": false,
    "dock": "right",
    "hide_root": true,
    "entry_spacing": "standard",
    "show_diagnostics": "all"
  },

  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },

  "base_keymap": "VSCode",
  "vim_mode": true,
  "relative_line_numbers": "wrapped",

  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 20,
  "ui_font_weight": 600.0,

  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 18,
  "buffer_font_weight": 600.0,
  "buffer_line_height": {
    "custom": 1.6
  },

  "theme": {
    "mode": "system",
    "light": "Modern Vesper",
    "dark": "Modern Vesper"
  },

  "active_pane_modifiers": {
    "inactive_opacity": 0.8
  },

  "bottom_dock_layout": "full",

  "gutter": {
    "line_numbers": true,
    "runnables": false,
    "breakpoints": true,
    "folds": true,
    "min_line_number_digits": 0
  },

  "disable_ai": true,
  "agent": {
    "button": false,
    "model_parameters": []
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}

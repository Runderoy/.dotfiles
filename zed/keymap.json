[
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-'": "editor::ShowWordCompletions",
      "cmd-e": "tab_switcher::Toggle"
    }
  },
  {
    "context": "TabSwitcher",
    "bindings": {
      "cmd-e": "menu::SelectNext",
      "shift-cmd-e": "menu::SelectPrevious"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-b": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-cmd-b": "workspace::ToggleLeftDock"
    }
  }
]

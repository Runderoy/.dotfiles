[
 {
    "context": "Workspace",
    "bindings": {
      "shift shift": "file_finder::Toggle",
      "cmd-b": "workspace::ToggleRightDock",
      "alt-cmd-b": "workspace::ToggleLeftDock",
      "cmd-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-'": "editor::ShowCompletions",
      "cmd-e": "tab_switcher::Toggle"
    }
  },
  {
    "context": "TabSwitcher",
    "bindings": {
      "cmd-e": "menu::SelectNext",
      "shift-cmd-e": "menu::SelectPrevious"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "k j": "vim::NormalBefore"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == helix_normal || vim_mode == visual",
    "bindings": {
      "shift-s": "vim::PushSneakBackward"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == helix_normal || vim_mode == visual",
    "bindings": {
      "s": "vim::PushSneak"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-r": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-r": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-shift-e": "project_panel::ToggleFocus"
    }
  }
]
